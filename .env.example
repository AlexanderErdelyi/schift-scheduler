# Environment Configuration
# Copy this file to .env and configure as needed

# Server Configuration
PORT=3000

# GitHub Copilot SDK (optional)
# If not set, the SDK will try to auto-detect the CLI
# COPILOT_CLI_PATH=/path/to/copilot-cli

# Future: Database Configuration
# Uncomment and configure when adding persistent storage
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=shift_scheduler
# DB_USER=your_user
# DB_PASSWORD=your_password
